{
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git branch --show-current:*)",
      "Bash(git rev-parse --abbrev-ref --symbolic-full-name @{upstream}:*)",
      "Bash(git remote get-url:*)",
      "Bash(git tag --list:*)",
      "Bash(git describe --tags --abbrev=0:*)",
      "Bash(rg --files:*)",
      "Bash(gh pr view:*)",
      "Bash(glab mr view:*)",
      "Bash(gh release view:*)",
      "Bash(glab release view:*)",
      "Bash(git fetch:*)",
      "Bash(gh pr checks:*)",
      "Bash(glab ci status:*)"
    ],
    "ask": [
      "Bash(git add:*)",
      "Bash(git restore --staged:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr edit:*)",
      "Bash(glab mr create:*)",
      "Bash(glab mr update:*)",
      "Bash(gh release create:*)",
      "Bash(glab release create:*)",
      "Bash(gh pr merge:*)",
      "Bash(glab mr merge:*)"
    ],
    "deny": [
      "Bash(git reset --hard:*)",
      "Bash(git checkout --:*)",
      "Bash(git clean:*)"
    ]
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "printf '%s\\n' 'For any code change: implement through dev:subagents and apply dev:design-principles, dev:testing, dev:self-documenting, and dev:research. For UI work also apply ui:design-system and ui:screens and load the installed design and motion skills. Reply per dev:reporting. Ship through ship:commit and ship:pr.'"
          }
        ]
      }
    ]
  }
}
