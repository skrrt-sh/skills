{
  "default": true,
  "MD013": {
    "line_length": 120,
    "code_blocks": false,
    "tables": false
  },
  "MD024": {
    "siblings_only": true
  },
  "MD025": {
    "front_matter_title": ""
  },
  "MD033": {
    "allowed_elements": [
      "a",
      "br",
      "details",
      "div",
      "h1",
      "img",
      "kbd",
      "p",
      "picture",
      "source",
      "strong",
      "sub",
      "summary",
      "sup"
    ]
  },
  "MD060": {
    "style": "compact"
  }
}
